# ==== Database (PostgreSQL) ====
# Local (Docker): dùng đúng thông tin trong docker-compose.yml ở thư mục gốc
DATABASE_URL="postgresql://doreto:doreto_secret@localhost:5433/doreto_web?schema=public"
# Production (Google Cloud SQL): thay bằng connection string của Cloud SQL
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/doreto_web?schema=public"

# ==== JWT ====
JWT_SECRET="đổi-thành-chuỗi-bí-mật-riêng"
JWT_EXPIRES="1h"
JWT_REFRESH_SECRET="đổi-thành-chuỗi-bí-mật-refresh-riêng"
JWT_REFRESH_EXPIRES="7d"

# ==== Server ====
PORT="8081"

# ==== Cloudflare R2 (lưu ảnh + video) ====
# Bucket + folder + CDN riêng cho Doreto — tách hẳn khỏi decor.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT="https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="doreto-web"
R2_FOLDER="doreto"
R2_PUBLIC_URL="https://cdn.dorreto.com"

# ==== Tích hợp CRM ====
# Chiều PUSH: đẩy lead (đơn hàng + liên hệ) sang webhook CRM.
# Để trống thì lead nằm lại outbox (không mất), CRM chỉ nhận khi đã cấu hình.
CRM_DECOR_WEBHOOK_URL=""
CRM_DECOR_WEBHOOK_SECRET=""
# Chiều PULL: CRM gọi GET /analytics/summary để đọc số liệu funnel của web này.
ANALYTICS_API_SECRET=""
ANALYTICS_SITE_ID="doreto-web"
ANALYTICS_SITE_LINE="THOI_TRANG"
