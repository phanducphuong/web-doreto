# ==== Database (PostgreSQL) ====
# Local (Docker): dùng đúng thông tin trong docker-compose.yml ở thư mục gốc
DATABASE_URL="postgresql://doreto:doreto_secret@localhost:5433/doreto_web?schema=public"
# Production (Google Cloud SQL): thay bằng connection string của Cloud SQL
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/doreto_web?schema=public"

# ==== JWT ====
JWT_SECRET="đổi-thành-chuỗi-bí-mật-riêng"
JWT_EXPIRES="1h"
JWT_REFRESH_SECRET="đổi-thành-chuỗi-bí-mật-refresh-riêng"
JWT_REFRESH_EXPIRES="7d"

# ==== Server ====
# Cổng 8082 để không đụng backend dự án web decor (8081)
PORT="8082"

# ==== Cloudflare R2 (lưu ảnh + video, S3-compatible) ====
# doreto dùng BUCKET RIÊNG 'doreto-web' để tách hẳn file với decor (đúng phương án phân vùng).
# Lấy các giá trị này trong Cloudflare Dashboard > R2.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Endpoint có thể để trống nếu đã có R2_ACCOUNT_ID (tự suy ra https://<account>.r2.cloudflarestorage.com)
R2_ENDPOINT=""
R2_BUCKET_NAME="doreto-web"
R2_FOLDER="doreto"
# Domain CDN công khai gắn với bucket (Cloudflare R2 > Settings > Public access / custom domain)
R2_PUBLIC_URL="https://cdn.doreto.example.com"

# ==== Gemini (AI viết mô tả sản phẩm) ====
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
