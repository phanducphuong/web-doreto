# ==== Database (PostgreSQL) ====
# Local (Docker): dùng đúng thông tin trong docker-compose.yml ở thư mục gốc
DATABASE_URL="postgresql://doreto:doreto_secret@localhost:5433/doreto_web?schema=public"
# Production (Google Cloud SQL): thay bằng connection string của Cloud SQL
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/doreto_web?schema=public"

# ==== JWT ====
JWT_SECRET="đổi-thành-chuỗi-bí-mật-riêng"
JWT_EXPIRES="1h"
JWT_REFRESH_SECRET="đổi-thành-chuỗi-bí-mật-refresh-riêng"
JWT_REFRESH_EXPIRES="7d"

# ==== Server ====
# Cổng 8082 để không đụng backend dự án web decor (8081)
PORT="8082"

# ==== Cloudinary (lưu ảnh) ====
CLOUDINARY_CLOUD_NAME=""
API_KEY=""
API_SECRET=""
CLOUDINARY_FOLDER="doreto-web"

# ==== Gemini (AI viết mô tả sản phẩm) ====
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
