// Prisma schema cho Doreto (PostgreSQL)
// Khóa chính: UUID cho mọi bảng. API vẫn trả trường `_id` (map từ `id`) qua interceptor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==== Enums ====
enum Role {
  admin
  customer
}

enum PurchaseOrderStatus {
  cart
  pending
  confirmed
  shipped
  delivered
  cancelled
}

enum ContactSpamKind {
  email
  phone
}

// ==== Người dùng ====
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  password     String
  refreshToken String?
  role         Role      @default(customer)
  phoneNumber  String?   @unique
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses      Address[]
  purchaseOrders PurchaseOrder[]
  feedbacks      FeedbackProduct[] @relation("FeedbackAuthor")
  repliedFeedbacks FeedbackProduct[] @relation("FeedbackReplier")

  @@map("users")
}

// Tách từ User.addresses[] (mảng nhúng) thành bảng riêng
model Address {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  addressName     String?
  phoneNumber     String
  name            String
  detailedAddress String
  ward            String
  district        String
  city            String
  country         String?  @default("Việt Nam")
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ==== Danh mục (cây cha-con) ====
model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String
  parentId    String?  @db.Uuid
  order       Int?     @default(0)
  icon        String?
  description String?  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

// ==== Nhãn ====
model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  icon      String?
  order     Int?     @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductTag[]

  @@map("tags")
}

// ==== Sản phẩm ====
model Product {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  // Slug SEO cho URL /san-pham/:slug. Cố định sau khi đặt: đổi tên SP KHÔNG
  // tự đổi slug (phải sửa tay có chủ đích). Nullable để migrate an toàn trên
  // dữ liệu cũ; service luôn gán slug khi tạo/sửa nên SP mới luôn có slug.
  slug           String?  @unique
  description    String?
  normalizedName String   @default("")
  minPrice       Float    @default(0)
  maxPrice       Float    @default(0)
  purchaseCount  Int      @default(0)
  // Số "đã bán ảo" cộng thêm khi hiển thị (giữ từ bản MongoDB cũ, FE cộng real + ảo)
  virtualPurchaseCount Int @default(0)
  averageRating  Float    @default(0)
  ratingCount    Int      @default(0)
  isActive       Boolean  @default(true)
  stock          Int      @default(0)
  productOptions String[] @default([])
  // Bậc combo theo TỔNG số lượng (mua N sản phẩm) lưu riêng theo từng SP.
  // Mảng JSON: [{ quantity, price, originalPrice?, freeship?, label? }].
  // Đây là TẦNG GIÁ phủ lên trên biến thể màu/size, không phải biến thể.
  comboTiers     Json     @default("[]")
  imageUrls      String[] @default([])
  thumbnailUrls  String[] @default([])
  // Khung ảnh áp cho các ảnh trong mô tả ở trang chi tiết (admin chọn khi đăng SP)
  descriptionFrameId String? @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  optionValues OptionValue[]
  categories   ProductCategory[]
  tags         ProductTag[]
  purchaseItems PurchaseItem[]
  directFeedbacks FeedbackProduct[]
  similarProducts ProductSimilar[] @relation("ProductSimilarFrom")
  similarOf       ProductSimilar[] @relation("ProductSimilarTo")
  descriptionFrame ImageFrame? @relation(fields: [descriptionFrameId], references: [id], onDelete: SetNull)

  @@index([normalizedName])
  @@index([isActive, purchaseCount])
  @@index([minPrice])
  @@map("products")
}

// Biến thể sản phẩm (thay Product.optionValueIds nhúng bằng quan hệ 1-N)
model OptionValue {
  id                 String   @id @default(uuid()) @db.Uuid
  productId          String?  @db.Uuid
  code               String?  // Mã biến thể (SKU) do admin nhập
  imageUrl           String?
  price              Float
  originalPrice      Float?
  purchaseCount      Int?     @default(0)
  stock              Int?     @default(0)
  productOptionNames String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product       Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItems PurchaseItem[]

  @@index([productId])
  @@map("option_values")
}

// Bảng nối N-N Product <-> Category
model ProductCategory {
  productId  String   @db.Uuid
  categoryId String   @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

// Bảng nối tự tham chiếu: sản phẩm tương tự do admin chọn tay
model ProductSimilar {
  productId        String @db.Uuid
  similarProductId String @db.Uuid
  // Thứ tự admin chọn (hiển thị theo đúng thứ tự này)
  position         Int    @default(0)

  product        Product @relation("ProductSimilarFrom", fields: [productId], references: [id], onDelete: Cascade)
  similarProduct Product @relation("ProductSimilarTo", fields: [similarProductId], references: [id], onDelete: Cascade)

  @@id([productId, similarProductId])
  @@index([similarProductId])
  @@map("product_similars")
}

// Bảng nối N-N Product <-> Tag
model ProductTag {
  productId String @db.Uuid
  tagId     String @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

// ==== Đơn hàng ====
model PurchaseOrder {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String?             @db.Uuid
  status            PurchaseOrderStatus @default(pending)
  summaryPrice      Float               @default(0)
  nonLoginUserEmail String?
  address           Json? // snapshot địa chỉ giao (JSONB)
  deliveriedAt      DateTime?
  isFeedbacked      Boolean             @default(false)
  // Tracking phase 37: visitor gắn với đơn (không FK — đơn admin tạo tay không có visitor)
  visitorId         String?             @db.Uuid
  // Mã camp first-touch lúc đặt hàng, lưu nguyên văn từ URL
  camp              String?
  // Snapshot utm_* first-touch (JSONB), lưu nguyên văn
  utm               Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  purchaseItems PurchaseItem[]
  feedbacks     FeedbackProduct[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([visitorId])
  @@map("purchase_orders")
}

// Dòng chi tiết đơn (tách từ mảng nhúng PurchaseOrder.purchaseItems)
model PurchaseItem {
  id                  String @id @default(uuid()) @db.Uuid
  orderId             String @db.Uuid
  productId           String @db.Uuid
  productOptionValueId String @db.Uuid
  count               Int
  price               Float
  product             Json? // snapshot sản phẩm tại thời điểm mua (JSONB)
  productOptionValue  Json? // snapshot biến thể (JSONB)

  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productRef  Product       @relation(fields: [productId], references: [id])
  optionValue OptionValue   @relation(fields: [productOptionValueId], references: [id])

  @@index([orderId])
  @@index([productId])
  // Postgres KHÔNG tự tạo index cho FK phía con → mọi thao tác xóa/sửa option_values
  // phải seq-scan purchase_items để kiểm ràng buộc. Thêm index (btree, không cần extension).
  @@index([productOptionValueId])
  @@map("purchase_items")
}

// ==== Đánh giá sản phẩm ====
model FeedbackProduct {
  id              String    @id @default(uuid()) @db.Uuid
  // Nullable: feedback do admin tạo (migrate từ MongoDB cũ) không gắn user/đơn hàng
  userId          String?   @db.Uuid
  purchaseOrderId String?   @db.Uuid
  // Feedback admin gắn thẳng vào sản phẩm; feedback từ đơn hàng suy ra qua purchaseItems
  productId       String?   @db.Uuid
  displayName     String?
  isAdminCreated  Boolean   @default(false)
  comment         String?
  images          String[]  @default([])
  score           Int?
  adminReply      String?
  replyImages     String[]  @default([])
  repliedBy       String?   @db.Uuid
  repliedAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User?          @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)
  order    PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product  Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  replier  User?          @relation("FeedbackReplier", fields: [repliedBy], references: [id], onDelete: SetNull)

  @@unique([userId, purchaseOrderId])
  @@index([purchaseOrderId, isActive, createdAt])
  @@index([productId, isActive, createdAt])
  @@map("feedback_products")
}

// ==== Liên hệ ====
model ContactRequest {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  email     String?
  done      Boolean   @default(false)
  doneAt    DateTime?
  // Tracking phase 37: visitor gắn với liên hệ (không FK — form có thể gửi không kèm visitor)
  visitorId String?   @db.Uuid
  // Mã camp first-touch lúc gửi form, lưu nguyên văn từ URL
  camp      String?
  // Snapshot utm_* first-touch (JSONB), lưu nguyên văn
  utm       Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([visitorId])
  @@map("contact_requests")
}

model ContactSpamBlock {
  id        String          @id @default(uuid()) @db.Uuid
  kind      ContactSpamKind
  value     String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([kind, value])
  @@map("contact_spam_blocks")
}

// ==== Báo cáo tổng hợp theo ngày ====
model OrderDailyReport {
  id                String   @id @default(uuid()) @db.Uuid
  date              String   @unique
  pendingCount      Int      @default(0)
  confirmedCount    Int      @default(0)
  shippedCount      Int      @default(0)
  deliveredCount    Int      @default(0)
  cancelledCount    Int      @default(0)
  orderCount        Int      @default(0)
  grossRevenue      Float    @default(0)
  averageOrderValue Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("order_daily_reports")
}

model ProductDailyReport {
  id         String   @id @default(uuid()) @db.Uuid
  date       String
  productId  String   @db.Uuid
  soldQty    Int      @default(0)
  revenue    Float    @default(0)
  orderCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([date, productId])
  @@index([date])
  @@index([productId])
  @@map("product_daily_reports")
}

// ==== Khung ảnh mô tả sản phẩm ====
model ImageFrame {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  imageUrl    String
  insetTop    Float    @default(0)
  insetRight  Float    @default(0)
  insetBottom Float    @default(0)
  insetLeft   Float    @default(0)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("image_frames")
}

// ==== Tracking hành vi khách (phase 37) ====

// Phiên truy cập của khách (kể cả ẩn danh). id do client sinh (UUID) và gửi lên.
model VisitorSession {
  id             String   @id @default(uuid()) @db.Uuid
  // visitor_id từ cookie ẩn danh first-party (UUID client sinh)
  visitorId      String   @db.Uuid
  // Mã camp first-touch (vd S01-A), lưu nguyên văn không map
  camp           String?
  // Snapshot utm_* first-touch nguyên văn (JSONB)
  utm            Json?
  landingUrl     String?
  referrer       String?
  userAgent      String?
  // Cập nhật mỗi lần nhận page view/event — cùng chuỗi timestamp page_views dùng đo thời gian ở web
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pageViews PageView[]
  events    VisitorEvent[]

  @@index([visitorId])
  @@index([camp])
  @@index([createdAt])
  @@map("visitor_sessions")
}

// Lượt xem trang — bảng append-only, không cần updatedAt
model PageView {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  visitorId String   @db.Uuid
  // Denormalize camp first-touch để groupBy không phải join
  camp      String?
  path      String
  url       String
  referrer  String?
  createdAt DateTime @default(now())

  session VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([visitorId])
  @@index([camp])
  @@index([createdAt])
  @@map("page_views")
}

// Sự kiện funnel — type là String (whitelist ở DTO): product_view, add_to_cart,
// begin_checkout, order_success, contact_form. Không dùng enum Prisma để thêm loại
// event sau này không cần migration.
model VisitorEvent {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  visitorId String   @db.Uuid
  camp      String?
  type      String
  // Không FK sang products/orders — tracking phải fail-safe, SP bị xóa không được làm hỏng insert
  productId String?  @db.Uuid
  orderId   String?  @db.Uuid
  createdAt DateTime @default(now())

  session VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([visitorId])
  @@index([camp])
  @@index([type, createdAt])
  @@map("visitor_events")
}

// Báo cáo tổng hợp lượt truy cập theo ngày × camp (rebuild + upsert, analog OrderDailyReport)
model VisitDailyReport {
  id                 String   @id @default(uuid()) @db.Uuid
  // Định dạng YYYY-MM-DD (String như OrderDailyReport)
  date               String
  // Chuỗi rỗng = "không có camp" — sentinel vì Postgres unique cho phép trùng NULL,
  // upsert theo unique kép (date, camp) với NULL sẽ hỏng
  camp               String   @default("")
  sessionCount       Int      @default(0)
  visitorCount       Int      @default(0)
  pageViewCount      Int      @default(0)
  productViewCount   Int      @default(0)
  addToCartCount     Int      @default(0)
  beginCheckoutCount Int      @default(0)
  orderSuccessCount  Int      @default(0)
  contactFormCount   Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([date, camp])
  @@index([date])
  @@map("visit_daily_reports")
}

// ==== Outbox bắn lead sang CRM (phase 38) ====
// Ghi payload lead CÙNG transaction tạo đơn/liên hệ (at-least-once): đơn commit thì
// lead chắc chắn được xếp hàng. Worker nền POST sang webhook CRM với retry + backoff,
// idempotent nhờ @@unique(sourceKind, sourceId) — POST rồi PATCH cùng đơn chỉ 1 row (D-04, D-08).
model DecorLeadOutbox {
  id String @id @default(uuid()) @db.Uuid
  // 'order' (đơn PurchaseOrder) | 'contact' (liên hệ ContactRequest) — whitelist ở service, không enum để linh hoạt
  sourceKind String
  // id đơn/liên hệ decor
  sourceId String @db.Uuid
  // Nguyên body sẽ POST sang CRM (khớp CreateDecorLeadDto plan 02)
  payload Json
  // 'pending' | 'sent' | 'failed'
  status String @default("pending")
  // Số lần đã thử gửi
  attempts Int @default(0)
  // Lỗi gửi gần nhất (không chứa PII payload)
  lastError String?
  // Thời điểm đủ điều kiện gửi lại (backoff)
  nextAttemptAt DateTime @default(now())
  // Thời điểm gửi thành công
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Chống enqueue trùng: mỗi đơn/liên hệ đúng 1 row (D-08)
  @@unique([sourceKind, sourceId])
  // Worker quét pending tới hạn nhanh
  @@index([status, nextAttemptAt])
  @@map("decor_lead_outbox")
}
